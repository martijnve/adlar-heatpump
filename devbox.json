{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.2/.schema/devbox.schema.json",
  "packages": [
    "python312@latest",
    "ruff@latest",
    "nodejs@22"
  ],
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null",
      "(cd frontend && [ -d node_modules ] || npm ci --silent)"
    ],
    "scripts": {
      "setup": [
        "python3 -m venv .venv",
        ".venv/bin/pip install -q -r requirements_test.txt"
      ],
      "test": [
        "test -x .venv/bin/pytest || devbox run setup",
        ".venv/bin/pytest tests",
        "(cd frontend && npx vitest run)"
      ],
      "lint": [
        "(cd frontend && npx tsc --noEmit)",
        "ruff check custom_components tests"
      ],
      "build": [
        "(cd frontend && npm run build)"
      ]
    }
  }
}
